+// ModernGekko: in-game settings menu. Set from the platform layer's key
+// handler, read by OnScreenUI::Finalize() which draws the menu into the
+// existing in-game ImGui context.
+extern std::atomic<bool> g_ingame_menu_open;
+// Set by the menu, consumed by the platform layer, which owns the window.
+extern std::atomic<bool> g_ingame_fullscreen_request;
+// Set by the menu's Exit button, consumed by the platform layer. Exiting has
+// to go through the platform: Core::Stop() alone stops the emulated machine
+// but leaves the platform's MainLoop running, so the window would linger.
+extern std::atomic<bool> g_ingame_exit_request;
+
+// Set by the menu's Restart button. A guest-side reset (ResetButton_Tap)
+// cannot work here: the statically recompiled module is initialised once and
+// cannot be re-entered from the reset vector, so the video backend rebuilds
+// but the guest never resumes - a black screen at a steady frame rate with
