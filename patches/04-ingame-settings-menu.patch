+  c[ImGuiCol_CheckMark]       = yellow;
+  c[ImGuiCol_SliderGrab]      = yellow;
+  c[ImGuiCol_SliderGrabActive]= yellow_hi;
+  c[ImGuiCol_Header]          = blue_lt;
+  c[ImGuiCol_HeaderHovered]   = yellow;
+  c[ImGuiCol_HeaderActive]    = yellow_hi;
+  c[ImGuiCol_Separator]       = yellow;
+  c[ImGuiCol_PopupBg]         = blue;
+  c[ImGuiCol_ScrollbarGrab]   = yellow;
+  (void)red;
