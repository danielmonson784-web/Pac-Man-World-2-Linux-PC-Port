+  st.FrameBorderSize   = 1.0f;
+  st.WindowPadding     = ImVec2(14, 12);
+  st.ItemSpacing       = ImVec2(9, 8);
+
+  ImVec4* c = st.Colors;
+  c[ImGuiCol_WindowBg]        = blue;
+  c[ImGuiCol_Border]          = yellow;
+  c[ImGuiCol_TitleBg]         = blue_mid;
