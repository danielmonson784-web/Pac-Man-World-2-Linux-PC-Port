+// Every toggleable data value of the patch: {addr, wide, neutral}.
+// The three parked constants come first; their neutral values make every cave
+// stub an identity operation (the multipliers become 1.0 and the replacement
+// constants revert to what the pristine instructions loaded).
+struct Row
+{
+  u32 addr, wide, neutral;
+};
