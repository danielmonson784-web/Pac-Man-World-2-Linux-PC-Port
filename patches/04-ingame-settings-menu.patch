+void OnField(Core::System& system)
+{
+
+  static int s_armed = 0;  // 0 probing, 1 armed, -1 permanently off
+  static bool s_wide = false;
+  static bool s_pending_wide = false;
+  static int s_pending_fields = 0;
+  static int s_probe_fields = 0;
+  static std::set<u32> s_seen;
+
+  if (s_armed < 0)
+    return;
+
+  auto& memory = system.GetMemory();
+  if (!memory.IsInitialized())
+    return;
+
+  if (s_armed == 0)
+  {
+    // Cheap one-read probe until the game has loaded far enough to decide.
+    if (SConfig::GetInstance().GetGameID().rfind("GP2E", 0) != 0 ||
+        ++s_probe_fields > 60 * 60 * 2)
+    {
+      s_armed = -1;
+      return;
+    }
+    if (memory.Read_U32(CAVE_MAGIC_ADDR) != CAVE_MAGIC)
+      return;
+    s_armed = 1;
+    s_wide = false;
+    Apply(memory, false);  // boot into correct 4:3 menus immediately
+    OSD::AddMessage("16:9 auto: on (wide in gameplay, 4:3 menus)", 5000);
+  }
+
+  const u32 state_fn = memory.Read_U32(STATE_PTR);
+  if (s_seen.insert(state_fn).second)
+  {
+    NOTICE_LOG_FMT(VIDEO, "PMW2WS: new state fn {:08x} ({})", state_fn,
+                   GAMEPLAY_FNS.count(state_fn) ? "wide" : "4:3");
+    // Bring-up aid: the NoGUI runtime does not route the log, so keep a plain
+    // file of every distinct state pointer seen (a handful per session).
+    if (FILE* f = std::fopen("userdata/pmw2ws_states.log", "a"))
+    {
+      std::fprintf(f, "%08x\n", state_fn);
+      std::fclose(f);
+    }
+    OSD::AddMessage(fmt::format("state {:08x}", state_fn), 2500);
+  }
+
+  const bool want_wide = GAMEPLAY_FNS.count(state_fn) != 0;
+  if (want_wide == s_wide)
+  {
+    s_pending_fields = 0;
+    return;
+  }
+  if (s_pending_wide != want_wide)
+  {
+    s_pending_wide = want_wide;
+    s_pending_fields = 0;
+  }
+  if (++s_pending_fields >= HYSTERESIS_FIELDS)
+  {
+    s_wide = want_wide;
+    s_pending_fields = 0;
+    Apply(memory, s_wide);
+  }
+}
+}  // namespace PMW2WS
