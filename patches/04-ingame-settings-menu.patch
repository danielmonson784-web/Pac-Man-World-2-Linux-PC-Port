+{
+  ImGuiStyle& st = ImGui::GetStyle();
+  const ImVec4 yellow    = ImVec4(1.00f, 0.80f, 0.00f, 1.00f);
+  const ImVec4 yellow_hi = ImVec4(1.00f, 0.90f, 0.30f, 1.00f);
+  const ImVec4 blue      = ImVec4(0.05f, 0.09f, 0.44f, 0.96f);
+  const ImVec4 blue_mid  = ImVec4(0.10f, 0.16f, 0.60f, 1.00f);
+  const ImVec4 blue_lt   = ImVec4(0.16f, 0.24f, 0.78f, 1.00f);
+  const ImVec4 red       = ImVec4(0.85f, 0.16f, 0.16f, 1.00f);
+
+  st.WindowRounding    = 10.0f;
+  st.FrameRounding     = 7.0f;
+  st.GrabRounding      = 7.0f;
+  st.PopupRounding     = 7.0f;
