--- a/GXRuntime/include/core/cpu.h
+++ b/GXRuntime/include/core/cpu.h
@@ -30,7 +30,7 @@ extern "C" {
 //   consumes and resets it (Dolphin chassis: per-dispatch flush into
 //   ppc_state.downcount). Hosts that do not meter guest time may ignore it
 //   (s64: it cannot wrap in any realistic session).
-#define GXRUNTIME_CPU_ABI_VERSION 3u
+#define GXRUNTIME_CPU_ABI_VERSION 4u
 #define GXRUNTIME_CPU_ABI_DOLRECOMP_PREFIX 1u
 #define GXRUNTIME_CPU_ABI_EXTERNAL_POINTER_EXTENSION 1u
 
@@ -153,6 +153,10 @@ struct CPUState {
     u32 ram_size;
     PPCExternalPointer external_pointer;
     s64 downcount;
+    /* ABI v4: cycle ceiling for a single recompiled dispatch. Present in
+       DolRecomp's cpu.h and ModernGekko's cpu_state.h; it was missing here,
+       so module_export.c stamped 3/3528 and every module was rejected. */
+    s64 cycle_budget;
     u8* exram;
     u32 exram_size;
     PPCSPRRead spr_read;
