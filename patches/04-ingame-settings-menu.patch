+// Enables or disables the widescreen Gecko code in GameSettings/<id>.ini - the
+// same file and section Dolphin's own Gecko UI writes. Returns false if the
+// code is not present at all, so the checkbox can hide rather than lie.
+bool WriteWidescreenEnabled(bool on)
+{
+  const auto& sconfig = SConfig::GetInstance();
+  const Common::IniFile global_ini = sconfig.LoadDefaultGameIni();
+  Common::IniFile local_ini = sconfig.LoadLocalGameIni();
+
+  std::vector<Gecko::GeckoCode> codes = Gecko::LoadCodes(global_ini, local_ini);
+  bool found = false;
+  for (Gecko::GeckoCode& code : codes)
+  {
+    if (code.name != WIDESCREEN_CODE_NAME)
+      continue;
+    code.enabled = on;
+    found = true;
+  }
+  if (!found)
+    return false;
+
+  const std::string path =
+      File::GetUserPath(D_GAMESETTINGS_IDX) + SConfig::GetInstance().GetGameID() + ".ini";
+  const std::string header = ReadLeadingComments(path);
+
+  Gecko::SaveCodes(local_ini, codes);
+  if (!local_ini.Save(path))
+    return false;
+  RestoreLeadingComments(path, header);
+
+  // The codes are inert unless the cheat engine is running at all.
+  if (on)
+    Config::SetBaseOrCurrent(Config::MAIN_ENABLE_CHEATS, true);
+  return true;
+}
