+// First word of the widescreen code cave; present only in the patched DOL.
+constexpr u32 CAVE_MAGIC_ADDR = 0x8020C57C;
+constexpr u32 CAVE_MAGIC = 0xFC801890;  // fmr f4,f3
+
+// The main loop's per-state update-callback pointer (r13 - 0x7048).
+constexpr u32 STATE_PTR = 0x8050C418;
