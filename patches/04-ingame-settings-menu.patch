+// Modding. Four independent surfaces, from least to most invasive:
+//
+//   1. Custom textures  - PNG replacements matched by content hash.
+//   2. Graphics mods    - draw-call level edits (hide/tint/replace geometry).
+//   3. Cheat codes      - Gecko/AR, i.e. arbitrary game code and memory.
+//   4. Raw game files   - this port boots from an EXTRACTED disc, so all 1806
+//                         asset files are ordinary files on disk and can just
+//                         be edited or swapped. That is the "change anything"
+//                         route; MODDING.txt documents the formats.
+//
+// Everything here is Dolphin functionality that simply had no way to be
+// reached without a GUI. Nothing modifies the shipped executable.
+void DrawModdingSection()
+{
+  const std::string game_id = SConfig::GetInstance().GetGameID();
+
+  ImGui::TextDisabled("Textures");
+  bool custom = Config::Get(Config::GFX_HIRES_TEXTURES);
+  if (ImGui::Checkbox("Load custom textures", &custom))
+    Config::SetBaseOrCurrent(Config::GFX_HIRES_TEXTURES, custom);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("PNG packs in Load/Textures/%s/. Re-enter a level to apply.",
+                      game_id.c_str());
+
+  if (custom)
+  {
+    bool prefetch = Config::Get(Config::GFX_CACHE_HIRES_TEXTURES);
+    if (ImGui::Checkbox("  Preload into RAM", &prefetch))
+      Config::SetBaseOrCurrent(Config::GFX_CACHE_HIRES_TEXTURES, prefetch);
+    if (ImGui::IsItemHovered())
+      ImGui::SetTooltip("Costs memory and load time, removes mid-level hitching.");
+  }
+
+  bool dump = Config::Get(Config::GFX_DUMP_TEXTURES);
+  if (ImGui::Checkbox("Dump textures while playing", &dump))
+    Config::SetBaseOrCurrent(Config::GFX_DUMP_TEXTURES, dump);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Writes what the game draws to Dump/Textures/%s/.\n"
+                      "Turn back off when done - it costs performance and disk.",
+                      game_id.c_str());
+
+  ImGui::Spacing();
+  ImGui::TextDisabled("Geometry and code");
+
+  bool gfxmods = Config::Get(Config::GFX_MODS_ENABLE);
+  if (ImGui::Checkbox("Graphics mods", &gfxmods))
+    Config::SetBaseOrCurrent(Config::GFX_MODS_ENABLE, gfxmods);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Loads mod packs from Load/GraphicMods/.\n"
+                      "These can hide, tint, move or replace individual draw calls.");
+
+  bool cheats = Config::Get(Config::MAIN_ENABLE_CHEATS);
+  if (ImGui::Checkbox("Gecko / AR codes", &cheats))
+    Config::SetBaseOrCurrent(Config::MAIN_ENABLE_CHEATS, cheats);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Runs code patches from GameSettings/%s.ini.\n"
+                      "This can change any game behaviour. Takes effect on restart.",
+                      game_id.c_str());
+
+  ImGui::Spacing();
+  ImGui::TextDisabled("Load/Textures/%s/   Load/GraphicMods/", game_id.c_str());
+  ImGui::TextDisabled("Game/files/  <- all 1806 raw assets, editable directly");
+  ImGui::TextDisabled("Full instructions in MODDING.txt");
+}
+
+void DrawIngameMenu()
+{
+  if (!g_ingame_menu_open.load(std::memory_order_relaxed))
+    return;
+
+  auto& system = Core::System::GetInstance();
+  ImGuiIO& io = ImGui::GetIO();
+
+  // The OS pointer is the one and only cursor. Drawing ImGui's software
+  // cursor on top produced a second (white) arrow - the mapping from window
+  // to backbuffer coordinates is proportional, so the real pointer already
+  // sits exactly over whatever a click will hit.
+  io.MouseDrawCursor = false;
+  ApplyPacManTheme();
+
+  ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f),
+                          ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+  ImGui::SetNextWindowBgAlpha(0.92f);
+
+  const bool shown = ImGui::Begin("Settings", nullptr,
+                   ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoCollapse |
+                       ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoSavedSettings);
+  if (shown)
+  {
+    ImGui::TextDisabled("Game continues running behind this menu.");
+    ImGui::Separator();
+
+    // --- video ---
+    int scale = Config::Get(Config::GFX_EFB_SCALE);
+    const char* const scales[] = {"Auto", "Native (640x528)", "2x", "3x", "4x",
+                                  "5x",   "6x",               "7x", "8x"};
+    if (scale >= 0 && scale < IM_ARRAYSIZE(scales))
+    {
+      if (ImGui::Combo("Internal resolution", &scale, scales, IM_ARRAYSIZE(scales)))
+        Config::SetBaseOrCurrent(Config::GFX_EFB_SCALE, scale);
+    }
+
+    // No widescreen-hack checkbox here on purpose. This port renders 16:9
+    // NATIVELY - the game lays out its own projection, HUD and 2D for a wide
+    // screen via the Gecko codes in GameSettings/GP2EAF.ini. Turning Dolphin's
+    // hack on as well would widen an already-wide image and double-correct it.
+    // The aspect combo stays, so 4:3 is still reachable.
+    // Only offer this if the code is actually present in this install's
+    // GameSettings, so the checkbox can never claim to do something it cannot.
+    // Native 16:9 toggle. On: the GAME renders wide (Gecko values) and the
+    // presentation is forced to 16:9 to un-squeeze it. Off: pristine neutrals,
+    // a true 4:3 with black bars.
+    static const bool ws_available = WidescreenCodeAvailable();
+    if (ws_available)
+    {
+      bool wide = WidescreenFlag();
+      if (ImGui::Checkbox("Native 16:9 widescreen", &wide))
+      {
+        if (WriteWidescreenEnabled(wide))
+        {
+          WidescreenFlag() = wide;
+          s_widescreen_reset_pending = true;
+          // NOTE: the aspect is deliberately NOT changed here. The code patches
+          // only take effect on the reset below, so changing the presentation
+          // now would leave the two disagreeing until then - a wide render shown
+          // in a 4:3 frame looks squeezed, and a 4:3 render shown wide looks
+          // stretched. Both move together, on the reset.
+        }
+      }
+      if (s_widescreen_reset_pending)
+      {
+        ImGui::TextColored(ImVec4(1.00f, 0.82f, 0.16f, 1.00f), "Reset to apply");
+        ImGui::SameLine();
+        if (ImGui::Button("Reset now"))
+        {
+          s_widescreen_reset_pending = false;
+          // Aspect flips together with the code state, so render and
+          // presentation never disagree. ON: the guest renders anamorphic 16:9
+          // and the presentation stretches it back out. OFF: a genuine 4:3
+          // render, presented 4:3.
+          Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO,
+                                   WidescreenFlag() ? AspectMode::ForceWide
+                                                    : AspectMode::ForceStandard);
+          g_ingame_menu_open.store(false, std::memory_order_relaxed);
+          g_ingame_restart_request.store(true, std::memory_order_relaxed);
+        }
+      }
+      if (ImGui::IsItemHovered())
+      {
+        ImGui::SetTooltip("On: the GAME renders 16:9 natively.\n"
+                          "Off: true 4:3 with black bars.\n"
+                          "Applies immediately.");
+      }
+    }
+
+    int aspect = static_cast<int>(Config::Get(Config::GFX_ASPECT_RATIO));
+    const char* const aspects[] = {"Auto", "Force 16:9", "Force 4:3", "Stretch"};
+    if (aspect >= 0 && aspect < IM_ARRAYSIZE(aspects))
+    {
+      if (ImGui::Combo("Aspect ratio", &aspect, aspects, IM_ARRAYSIZE(aspects)))
+        Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, static_cast<AspectMode>(aspect));
+    }
+
+
+    // --- display ---
+    if (ImGui::Button("Toggle fullscreen", ImVec2(-1, 0)))
+      g_ingame_fullscreen_request.store(true, std::memory_order_relaxed);
+
+    int msaa_idx = 0;
+    const u32 msaa_now = Config::Get(Config::GFX_MSAA);
+    const u32 msaa_vals[] = {1u, 2u, 4u, 8u};
+    for (int i = 0; i < 4; ++i)
+      if (msaa_vals[i] == msaa_now) msaa_idx = i;
+    const char* const msaa_names[] = {"Off", "2x", "4x", "8x"};
+    if (ImGui::Combo("Anti-aliasing (MSAA)", &msaa_idx, msaa_names, 4))
+      Config::SetBaseOrCurrent(Config::GFX_MSAA, msaa_vals[msaa_idx]);
+
+    bool ssaa = Config::Get(Config::GFX_SSAA);
+    if (ImGui::Checkbox("Supersampling (SSAA)", &ssaa))
+      Config::SetBaseOrCurrent(Config::GFX_SSAA, ssaa);
+
+    // --- post-processing ---
+    // "Scanlines" used to be listed here mapped to nightvision2scanlines, which
+    // is a night-vision shader with scanlines bolted on - it tinted everything
+    // green. Removed; CRT Sharp is the scanline-only option now.
+    static const char* const shaders[] = {"(off)",   "CRT",       "CRT Sharp", "CRT Slot Mask",
+                                          "CRT Heavy", "FXAA",    "Grayscale"};
+    static const char* const shader_ids[] = {"",          "CRT",  "CRT-Sharp", "CRT-Slot-Mask",
+                                             "CRT-Heavy", "FXAA", "grayscale"};
+    const std::string cur_shader = Config::Get(Config::GFX_ENHANCE_POST_SHADER);
+    int shader_idx = 0;
+    for (int i = 0; i < IM_ARRAYSIZE(shader_ids); ++i)
+      if (cur_shader == shader_ids[i]) shader_idx = i;
+    if (ImGui::Combo("Post-process", &shader_idx, shaders, IM_ARRAYSIZE(shaders)))
+      Config::SetBaseOrCurrent(Config::GFX_ENHANCE_POST_SHADER,
+                               std::string(shader_ids[shader_idx]));
+
+    // --- gamma -------------------------------------------------------------
+    // Dolphin's colour correction decodes the frame with "game gamma" and
+    // re-encodes it for an sRGB display, so the net transfer is roughly
+    // pow(c, game_gamma / 2.2): 2.2 is neutral and larger values darken the
+    // midtones. Pac-Man World 2 also shipped on PS2 and Xbox, and those ports
+    // were mastered against different assumed display gammas, which is the
+    // main reason they don't look alike. These presets approximate that; the
+    // slider below is there because taste and panel calibration vary.
+    {
+      static const char* const gamma_names[] = {"Native (off)", "GameCube", "Xbox (brighter)",
+                                                "PS2 (darker)", "Custom"};
+      static const float gamma_vals[] = {0.0f, 2.35f, 2.20f, 2.60f, 0.0f};
+      const bool cc_on = Config::Get(Config::GFX_CC_CORRECT_GAMMA);
+      const float cur_gamma = Config::Get(Config::GFX_CC_GAME_GAMMA);
+
+      int gamma_idx = 0;
+      if (cc_on)
+      {
+        gamma_idx = 4;  // custom unless it matches a preset
+        for (int i = 1; i <= 3; ++i)
+        {
+          if (cur_gamma > gamma_vals[i] - 0.005f && cur_gamma < gamma_vals[i] + 0.005f)
+            gamma_idx = i;
+        }
+      }
+
+      if (ImGui::Combo("Gamma", &gamma_idx, gamma_names, IM_ARRAYSIZE(gamma_names)))
+      {
+        if (gamma_idx == 0)
+        {
+          Config::SetBaseOrCurrent(Config::GFX_CC_CORRECT_GAMMA, false);
+        }
+        else
+        {
+          Config::SetBaseOrCurrent(Config::GFX_CC_CORRECT_GAMMA, true);
+          if (gamma_idx != 4)
+            Config::SetBaseOrCurrent(Config::GFX_CC_GAME_GAMMA, gamma_vals[gamma_idx]);
+        }
+      }
+
+      if (Config::Get(Config::GFX_CC_CORRECT_GAMMA))
+      {
+        float g = Config::Get(Config::GFX_CC_GAME_GAMMA);
+        if (ImGui::SliderFloat("  gamma value", &g, Config::GFX_CC_GAME_GAMMA_MIN,
+                               Config::GFX_CC_GAME_GAMMA_MAX, "%.2f"))
+          Config::SetBaseOrCurrent(Config::GFX_CC_GAME_GAMMA, g);
+      }
+    }
+
+    ImGui::Separator();
+
+    // --- shaders ------------------------------------------------------------
+    // Stutter on first sight of an effect is shader compilation happening mid
+    // frame. Preloading builds the whole cache before the game starts: a longer
+    // wait once, then no hitching. The cache is per GPU and driver version, so
+    // the long wait returns after a driver update, then goes away again.
+    bool preload = Config::Get(Config::GFX_WAIT_FOR_SHADERS_BEFORE_STARTING);
+    if (ImGui::Checkbox("Preload all shaders at startup", &preload))
+      Config::SetBaseOrCurrent(Config::GFX_WAIT_FOR_SHADERS_BEFORE_STARTING, preload);
+    if (ImGui::IsItemHovered())
+    {
+      ImGui::SetTooltip("Compiles every shader before the game starts, so nothing\n"
+                        "stutters later. The first launch after enabling this takes\n"
+                        "noticeably longer; after that the cache is reused.\n"
+                        "Takes effect on the next launch.");
+    }
+
+    // Ubershaders are a slower catch-all that can draw anything immediately, so
+    // the specialised shader can compile in the background without stalling.
+    // Which trade-off is right depends on the GPU, so expose it rather than
+    // picking for the user.
+    int sc_mode = static_cast<int>(Config::Get(Config::GFX_SHADER_COMPILATION_MODE));
+    const char* const sc_names[] = {"Synchronous (may stutter)", "Synchronous ubershaders",
+                                    "Asynchronous ubershaders (smoothest)",
+                                    "Skip drawing until ready"};
+    if (sc_mode >= 0 && sc_mode < IM_ARRAYSIZE(sc_names))
+    {
+      if (ImGui::Combo("Shader compilation", &sc_mode, sc_names, IM_ARRAYSIZE(sc_names)))
+      {
+        Config::SetBaseOrCurrent(Config::GFX_SHADER_COMPILATION_MODE,
+                                 static_cast<ShaderCompilationMode>(sc_mode));
+      }
+    }
+    if (ImGui::IsItemHovered())
+    {
+      ImGui::SetTooltip("How shaders are built while playing.\n"
+                        "Asynchronous ubershaders avoids stutter at some GPU cost;\n"
+                        "Synchronous is exact but can hitch on new effects.");
+    }
+
+    bool shader_cache = Config::Get(Config::GFX_SHADER_CACHE);
+    if (ImGui::Checkbox("Keep shader cache on disk", &shader_cache))
+      Config::SetBaseOrCurrent(Config::GFX_SHADER_CACHE, shader_cache);
+    if (ImGui::IsItemHovered())
+    {
+      ImGui::SetTooltip("Reuses compiled shaders across launches. Turning this off\n"
+                        "means recompiling everything every time - only useful when\n"
+                        "chasing a shader bug.");
+    }
+
+    ImGui::Spacing();
+
+    bool vsync = Config::Get(Config::GFX_VSYNC);
+    if (ImGui::Checkbox("V-Sync", &vsync))
+      Config::SetBaseOrCurrent(Config::GFX_VSYNC, vsync);
+
+    bool show_fps = Config::Get(Config::GFX_SHOW_FPS);
+    if (ImGui::Checkbox("Show FPS", &show_fps))
+      Config::SetBaseOrCurrent(Config::GFX_SHOW_FPS, show_fps);
+
+    ImGui::Separator();
+
+    // --- audio ---
+    int volume = Config::Get(Config::MAIN_AUDIO_VOLUME);
+    if (ImGui::SliderInt("Volume", &volume, 0, 100))
+    {
+      Config::SetBaseOrCurrent(Config::MAIN_AUDIO_VOLUME, volume);
+      AudioCommon::UpdateSoundStream(system);
+    }
+
+    bool muted = Config::Get(Config::MAIN_AUDIO_MUTED);
+    if (ImGui::Checkbox("Mute", &muted))
+    {
+      Config::SetBaseOrCurrent(Config::MAIN_AUDIO_MUTED, muted);
+      AudioCommon::UpdateSoundStream(system);
+    }
+
+    ImGui::Separator();
+
+    if (ImGui::CollapsingHeader("Mods"))
+      DrawModdingSection();
+
+    if (ImGui::CollapsingHeader("Input mapping"))
+      DrawInputMapping();
+
+    ImGui::Separator();
+
+    if (ImGui::Button("Resume", ImVec2(120, 0)))
+      g_ingame_menu_open.store(false, std::memory_order_relaxed);
+    ImGui::SameLine();
+    if (ImGui::Button("Restart", ImVec2(120, 0)))
+    {
+      // Not a guest reset - see g_ingame_restart_request. This closes the app
+      // cleanly and starts it again, which is also what picks up a widescreen
+      // change, since the Gecko codes are applied when the game boots.
+      g_ingame_menu_open.store(false, std::memory_order_relaxed);
+      g_ingame_restart_request.store(true, std::memory_order_relaxed);
+    }
+    if (ImGui::IsItemHovered())
+      ImGui::SetTooltip("Closes and reopens the game. Takes a few seconds.");
+    ImGui::SameLine();
+    if (ImGui::Button("Exit", ImVec2(120, 0)))
+    {
+      // Hand this to the platform layer so shutdown follows the same path as
+      // closing the window: core stopped, MainLoop ended, stats flushed.
+      g_ingame_menu_open.store(false, std::memory_order_relaxed);
+      g_ingame_exit_request.store(true, std::memory_order_relaxed);
+    }
+
+    ImGui::Separator();
+    ImGui::TextDisabled("Esc closes  -  Ctrl+Esc quits  -  F10 pause");
+  }
+  ImGui::End();
+}
