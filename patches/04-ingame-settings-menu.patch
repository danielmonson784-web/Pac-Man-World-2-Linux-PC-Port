+// ---- 16:9 ------------------------------------------------------------------
+// This game has no widescreen support of its own. The DOL was searched and
+// contains no 16:9 constant anywhere: 680.0 (the wide layout width), 0.752941
+// (the widescreen scale), 1.777778 (16/9) and 0.5625 (9/16) all appear ZERO
+// times, and the only aspect-related string in the binary is "dontLetterBox",
+// a cinematic camera parameter. So 16:9 comes from the Dolphin-wiki Gecko codes
+// for GP2EAF, which widen the game's OWN 2D layout space from 512 units to 680
+// (x85/64) and scale ~25 size constants by the reciprocal, so the HUD reaches
+// the edges of the frame instead of sitting in a 4:3 island.
+//
+// Those codes are re-applied every frame from the VI interrupt
+// (PatchEngine::ApplyFramePatches -> Gecko::RunCodeHandler), but 13 of them
+// patch instructions rather than data, and under static recompilation the
+// affected chunks have already fallen back to the interpreter. Un-patching that
+// mid-session is not safe, so a change here is applied on reset.
+constexpr char WIDESCREEN_CODE_NAME[] = "16:9 Widescreen";
+
+bool ReadWidescreenEnabled()
+{
+  const auto& sconfig = SConfig::GetInstance();
+  const Common::IniFile global_ini = sconfig.LoadDefaultGameIni();
+  const Common::IniFile local_ini = sconfig.LoadLocalGameIni();
+  for (const Gecko::GeckoCode& code : Gecko::LoadCodes(global_ini, local_ini))
+  {
+    if (code.name == WIDESCREEN_CODE_NAME)
+      return code.enabled;
+  }
+  return false;
+}
