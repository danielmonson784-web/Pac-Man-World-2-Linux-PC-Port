+// ~1/4 second of consecutive fields before committing a switch, so brief
+// transitions through loader states do not flap the aspect.
+constexpr int HYSTERESIS_FIELDS = 15;
+
+void Apply(Memory::MemoryManager& memory, bool wide)
+{
+  for (const Row& r : WS_TABLE)
+    memory.Write_U32(wide ? r.wide : r.neutral, r.addr);
+  Config::SetCurrent(Config::GFX_ASPECT_RATIO,
+                     wide ? AspectMode::ForceWide : AspectMode::ForceStandard);
+}
