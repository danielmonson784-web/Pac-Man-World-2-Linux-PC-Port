+// Live input remapping. Mirrors what DolphinQt's MappingWidget does, minus Qt:
+// start an InputDetector, pump it once per frame while the menu draws, then turn
+// the detections into an expression and write it into the control reference.
+std::unique_ptr<ciface::Core::InputDetector> s_detector;
+ControlReference* s_detect_target = nullptr;
+bool s_detect_any_device = false;
+
+void DrawInputMapping()
+{
+  if (!Pad::IsInitialized())
+  {
+    ImGui::TextDisabled("Pad is not initialized.");
+    return;
+  }
+
+  InputConfig* const cfg = Pad::GetConfig();
+  auto* const ctrl = cfg ? cfg->GetController(0) : nullptr;
+  if (ctrl == nullptr)
+  {
+    ImGui::TextDisabled("No controller configured on port 1.");
+    return;
+  }
+
+  // The device that unqualified expressions resolve against.
+  const std::string current_device = ctrl->GetDefaultDevice().ToString();
+  ImGui::SetNextItemWidth(320.0f);
+  if (ImGui::BeginCombo("Device", current_device.c_str()))
+  {
+    for (const std::string& dev : g_controller_interface.GetAllDeviceStrings())
+    {
+      const bool selected = dev == current_device;
+      if (ImGui::Selectable(dev.c_str(), selected))
+      {
+        const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+        ctrl->SetDefaultDevice(dev);
+        ctrl->UpdateReferences(g_controller_interface);
+        cfg->SaveConfig();
+      }
+      if (selected)
+        ImGui::SetItemDefaultFocus();
+    }
+    ImGui::EndCombo();
+  }
+
+  ImGui::Checkbox("Bind from any device", &s_detect_any_device);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Off: only the device above.\nOn: keyboard, mouse and every pad.");
+
+  // Pump an in-flight detection. This never blocks, so the menu keeps drawing
+  // at full rate while the user is pressing something.
+  if (s_detector)
+  {
+    const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+    s_detector->Update(std::chrono::seconds(3), std::chrono::milliseconds(0),
+                       std::chrono::seconds(5));
+    if (s_detector->IsComplete())
+    {
+      auto results = s_detector->TakeResults();
+      if (s_detect_target != nullptr &&
+          ciface::MappingCommon::ContainsCompleteDetection(results))
+      {
+        ciface::MappingCommon::RemoveSpuriousTriggerCombinations(&results);
+        s_detect_target->SetExpression(ciface::MappingCommon::BuildExpression(
+            results, ctrl->GetDefaultDevice(), ciface::MappingCommon::Quote::On));
+        ctrl->UpdateSingleControlReference(g_controller_interface, s_detect_target);
+        cfg->SaveConfig();
+      }
+      s_detector.reset();
+      s_detect_target = nullptr;
+    }
+  }
+
+  ImGui::Separator();
+
+  int id = 0;
+  for (const auto& group : ctrl->groups)
+  {
+    if (group->controls.empty())
+      continue;
+
+    const std::string& group_label = group->ui_name.empty() ? group->name : group->ui_name;
+    if (!ImGui::TreeNode(group_label.c_str()))
+      continue;
+
+    for (const auto& control : group->controls)
+    {
+      ControlReference* const ref = control->control_ref.get();
+      // Outputs are rumble motors, not something to bind a key to.
+      if (ref == nullptr || !ref->IsInput())
+        continue;
+
+      ImGui::PushID(id++);
+
+      const std::string& name = control->ui_name.empty() ? control->name : control->ui_name;
+      ImGui::TextUnformatted(name.c_str());
+      ImGui::SameLine(150.0f);
+
+      std::string label;
+      if (s_detector && s_detect_target == ref)
+        label = "[ press now ]";
+      else if (ref->GetExpression().empty())
+        label = "-";
+      else
+        label = ref->GetExpression();
+
+      if (ImGui::Button(label.c_str(), ImVec2(240.0f, 0.0f)) && !s_detector)
+      {
+        std::vector<std::string> devices{ctrl->GetDefaultDevice().ToString()};
+        if (s_detect_any_device)
+          devices = g_controller_interface.GetAllDeviceStrings();
+
+        s_detect_target = ref;
+        s_detector = std::make_unique<ciface::Core::InputDetector>();
+        const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+        s_detector->Start(g_controller_interface, devices);
+      }
+
+      ImGui::SameLine();
+      if (ImGui::SmallButton("Clear"))
+      {
+        const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+        ref->SetExpression("");
+        ctrl->UpdateSingleControlReference(g_controller_interface, ref);
+        cfg->SaveConfig();
+      }
+
+      ImGui::PopID();
+    }
+    ImGui::TreePop();
+  }
+
+  ImGui::Separator();
+  if (ImGui::Button("Reload from file"))
+    Pad::LoadConfig();
+  ImGui::SameLine();
+  if (ImGui::Button("Save mappings"))
+    cfg->SaveConfig();
+}
