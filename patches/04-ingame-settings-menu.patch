+}
+
+bool s_widescreen_reset_pending = false;
+
+// Common::IniFile::Save drops everything above the first section, and
+// Gecko::SaveCodes rewrites the code sections wholesale. This file's
+// documentation lives in a comment block at the top, so capture it and put it
+// back, or a toggle silently destroys it.
+std::string ReadLeadingComments(const std::string& path)
+{
+  std::ifstream in(path);
+  if (!in)
+    return {};
+  std::string line, header;
+  while (std::getline(in, line))
+  {
+    const std::string_view trimmed = StripWhitespace(line);
+    if (!trimmed.empty() && trimmed[0] != '#')
+      break;
+    header += line;
+    header += '\n';
+  }
+  return header;
+}
+
+void RestoreLeadingComments(const std::string& path, const std::string& header)
+{
+  if (header.empty())
+    return;
+  std::string body;
+  {
+    std::ifstream in(path);
+    if (!in)
+      return;
+    std::ostringstream ss;
+    ss << in.rdbuf();
+    body = ss.str();
+  }
+  // Only prepend if the save really dropped it, so repeated toggles cannot
+  // stack duplicate copies.
+  if (body.compare(0, header.size(), header) == 0)
+    return;
+  std::ofstream out(path, std::ios::trunc);
+  if (!out)
+    return;
+  out << header << body;
+}
