+void PlatformX11::PollOverlayInput()
+{
+  if (!m_poll_display)
+  {
+    m_poll_display = XOpenDisplay(nullptr);
+    if (!m_poll_display)
+      return;
+    // Start the cooldown here rather than at the epoch, so a phantom keymap
+    // read during startup cannot pop the menu open before the game appears.
+    m_last_toggle = std::chrono::steady_clock::now();
+  }
+
+  // --- Escape: edge-triggered toggle of the in-game menu ---
+  char keys[32];
+  XQueryKeymap(m_poll_display, keys);
+  const KeyCode esc = XKeysymToKeycode(m_poll_display, XK_Escape);
+  const bool esc_down = esc && (keys[esc >> 3] & (1 << (esc & 7))) != 0;
+
+  // Require two consecutive polls plus a cooldown. XQueryKeymap occasionally
+  // reports a phantom press, and the loop runs every ~1 ms, so a bare edge
+  // test flips the menu open and shut before it can be seen.
+  const bool stable_down = esc_down && m_escape_prev_sample;
+  const auto now = std::chrono::steady_clock::now();
+  const bool cooled = now - m_last_toggle > std::chrono::milliseconds(400);
+
+  if (stable_down && !m_escape_was_down && cooled)
+  {
+    m_last_toggle = now;
+    const bool opening = !VideoCommon::g_ingame_menu_open.load(std::memory_order_relaxed);
+    VideoCommon::g_ingame_menu_open.store(opening, std::memory_order_relaxed);
+    auto& system = Core::System::GetInstance();
+    // Deliberately NOT pausing: a paused core stops presenting frames, so
+    // OnScreenUI::Finalize() never runs and the menu could never draw itself.
+    (void)system;
+    // The menu uses the normal OS pointer as its only cursor (ImGui's
+    // software cursor is disabled) - nothing to hide or restore here. Undo
+    // any blanking a previous build may have left active.
+    if (opening && Config::Get(Config::MAIN_SHOW_CURSOR) != Config::ShowCursor::Never)
+      XUndefineCursor(m_display, m_window);
+  }
+  m_escape_prev_sample = esc_down;
+
+  // The menu cannot touch the window itself - it runs on the video thread and
+  // does not own the X connection - so it raises a flag and this consumes it.
+  if (VideoCommon::g_ingame_exit_request.exchange(false, std::memory_order_relaxed))
+  {
+    // Same call the window-manager close button makes, so the shutdown is
+    // identical to closing the window (which flushes the recompiler stats).
+    Stop();
+    return;
+  }
+
+  if (VideoCommon::g_ingame_fullscreen_request.exchange(false, std::memory_order_relaxed))
+  {
+    m_window_fullscreen = !m_window_fullscreen;
+    X11Utils::ToggleFullscreen(m_display, m_window);
+    if (m_xrr_config)
+      m_xrr_config->ToggleDisplayMode(m_window_fullscreen);
+  }
+  m_escape_was_down = stable_down;
+
+  if (!VideoCommon::g_ingame_menu_open.load(std::memory_order_relaxed) || !g_presenter)
+    return;
+
+  // The key map is what lets the overlay interpret key events at all.
+  // DolphinQt normally installs it; with Qt compiled out nothing did. It has
+  // to happen after the presenter exists, so do it once, lazily.
+  if (!m_keymap_set)
+  {
+    static constexpr DolphinKeyMap key_map = {
+        XK_Tab,     XK_Left,      XK_Right, XK_Up,     XK_Down,
+        XK_Page_Up, XK_Page_Down, XK_Home,  XK_End,    XK_Insert,
+        XK_Delete,  XK_BackSpace, XK_space, XK_Return, XK_Escape,
+        XK_KP_Enter, XK_a,        XK_c,     XK_v,      XK_x,
+        XK_y,       XK_z,
+    };
+    g_presenter->SetKeyMap(key_map);
+    m_keymap_set = true;
+  }
+
+  // --- mouse: poll position and buttons for the same reason ---
+  Window root_ret, child_ret;
+  int root_x, root_y, win_x, win_y;
+  unsigned int mask;
+  if (XQueryPointer(m_poll_display, m_window, &root_ret, &child_ret, &root_x, &root_y, &win_x,
+                    &win_y, &mask))
+  {
+    Window geo_root;
+    int geo_x, geo_y;
+    unsigned int win_w = 0, win_h = 0, geo_border, geo_depth;
+    XGetGeometry(m_poll_display, m_window, &geo_root, &geo_x, &geo_y, &win_w, &win_h, &geo_border,
+                 &geo_depth);
+    const float sx = win_w ? static_cast<float>(g_presenter->GetBackbufferWidth()) / win_w : 1.0f;
+    const float sy = win_h ? static_cast<float>(g_presenter->GetBackbufferHeight()) / win_h : 1.0f;
+    g_presenter->SetMousePos(static_cast<float>(win_x) * sx, static_cast<float>(win_y) * sy);
+    u32 buttons = 0;
+    if (mask & Button1Mask)
+      buttons |= 1u << 0;
+    if (mask & Button3Mask)
+      buttons |= 1u << 1;
+    if (mask & Button2Mask)
+      buttons |= 1u << 2;
+    g_presenter->SetMousePress(buttons);
+  }
+}
