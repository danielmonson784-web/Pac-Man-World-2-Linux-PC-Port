diff --git a/src/runtime/dolphin_runtime.cpp b/src/runtime/dolphin_runtime.cpp
index f9b5405..38e15a8 100644
--- a/src/runtime/dolphin_runtime.cpp
+++ b/src/runtime/dolphin_runtime.cpp
@@ -610,6 +610,16 @@ RuntimeCreateResult Runtime::Create(RuntimeConfig config) {
   if (!s_external_ui_common) {
     UICommon::SetUserDirectory(impl->config.user_directory.string());
     UICommon::Init();
+    // Upstream only ever calls this from DolphinQt's main(), which is not built
+    // here, so nothing was creating the user directories. Cache/ in particular
+    // never existed, and ShaderGenCommon's File::CreateDir for Cache/Shaders/ is
+    // non-recursive, so it failed on the missing parent every launch. The shader
+    // cache therefore never persisted - every session started cold with "Loaded 0
+    // cached shaders", and every effect the player had not seen yet in THAT
+    // session drew through the ubershader while it compiled. That is very
+    // expensive when SSAA is on, because SSAA here is per-sample shading, so the
+    // ubershader runs once per MSAA sample on every pixel it covers.
+    UICommon::CreateDirectories();
     impl->ui_initialized = true;
   }
   Config::SetBase(Config::MAIN_FULLSCREEN, impl->config.fullscreen);
