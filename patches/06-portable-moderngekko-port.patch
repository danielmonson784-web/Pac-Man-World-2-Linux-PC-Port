 namespace fs = std::filesystem;
 
+namespace
+{
+// MODERNGEKKO_SOURCE_DIR is baked in at compile time and points at the build
+// tree, which makes a shipped moderngekko-port unusable on any other machine.
+// Prefer, in order: an explicit env override, a tree next to the executable
+// (how a redistributable bundle is laid out), then the compiled-in path so
+// existing in-tree usage is unchanged.
+fs::path ResolveSourceRoot()
+{
+  auto looks_valid = [](const fs::path& p) {
+    std::error_code ec;
+    return fs::is_directory(p / "vendor/dolphin/GXRuntime", ec);
+  };
+
+  if (const char* env = std::getenv("MODERNGEKKO_SOURCE_DIR"))
+  {
+    const fs::path from_env(env);
+    if (looks_valid(from_env))
+      return from_env;
+  }
+
+#if !defined(_WIN32)
+  std::error_code ec;
+  const fs::path exe = fs::read_symlink("/proc/self/exe", ec);
+  if (!ec)
+  {
+    for (const char* sub : {"runtime", ".", ".."})
+    {
+      const fs::path candidate = exe.parent_path() / sub;
+      if (looks_valid(candidate))
+        return fs::weakly_canonical(candidate, ec);
+    }
+  }
+#endif
+
+  return fs::path(MODERNGEKKO_SOURCE_DIR);
+}
+}  // namespace
+
+
