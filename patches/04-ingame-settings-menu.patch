+// Modding. Four independent surfaces, from least to most invasive:
+//
+//   1. Custom textures  - PNG replacements matched by content hash.
+//   2. Graphics mods    - draw-call level edits (hide/tint/replace geometry).
+//   3. Cheat codes      - Gecko/AR, i.e. arbitrary game code and memory.
+//   4. Raw game files   - this port boots from an EXTRACTED disc, so all 1806
+//                         asset files are ordinary files on disk and can just
+//                         be edited or swapped. That is the "change anything"
+//                         route; MODDING.txt documents the formats.
+//
+// Everything here is Dolphin functionality that simply had no way to be
+// reached without a GUI. Nothing modifies the shipped executable.
+void DrawModdingSection()
+{
+  const std::string game_id = SConfig::GetInstance().GetGameID();
+
+  ImGui::TextDisabled("Textures");
+  bool custom = Config::Get(Config::GFX_HIRES_TEXTURES);
+  if (ImGui::Checkbox("Load custom textures", &custom))
+    Config::SetBaseOrCurrent(Config::GFX_HIRES_TEXTURES, custom);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("PNG packs in Load/Textures/%s/. Re-enter a level to apply.",
+                      game_id.c_str());
+
+  if (custom)
+  {
+    bool prefetch = Config::Get(Config::GFX_CACHE_HIRES_TEXTURES);
+    if (ImGui::Checkbox("  Preload into RAM", &prefetch))
+      Config::SetBaseOrCurrent(Config::GFX_CACHE_HIRES_TEXTURES, prefetch);
+    if (ImGui::IsItemHovered())
+      ImGui::SetTooltip("Costs memory and load time, removes mid-level hitching.");
+  }
+
+  bool dump = Config::Get(Config::GFX_DUMP_TEXTURES);
+  if (ImGui::Checkbox("Dump textures while playing", &dump))
+    Config::SetBaseOrCurrent(Config::GFX_DUMP_TEXTURES, dump);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Writes what the game draws to Dump/Textures/%s/.\n"
+                      "Turn back off when done - it costs performance and disk.",
+                      game_id.c_str());
+
+  ImGui::Spacing();
+  ImGui::TextDisabled("Geometry and code");
+
+  bool gfxmods = Config::Get(Config::GFX_MODS_ENABLE);
+  if (ImGui::Checkbox("Graphics mods", &gfxmods))
+    Config::SetBaseOrCurrent(Config::GFX_MODS_ENABLE, gfxmods);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Loads mod packs from Load/GraphicMods/.\n"
+                      "These can hide, tint, move or replace individual draw calls.");
+
+  bool cheats = Config::Get(Config::MAIN_ENABLE_CHEATS);
+  if (ImGui::Checkbox("Gecko / AR codes", &cheats))
+    Config::SetBaseOrCurrent(Config::MAIN_ENABLE_CHEATS, cheats);
+  if (ImGui::IsItemHovered())
+    ImGui::SetTooltip("Runs code patches from GameSettings/%s.ini.\n"
+                      "This can change any game behaviour. Takes effect on restart.",
+                      game_id.c_str());
+
+  ImGui::Spacing();
+  ImGui::TextDisabled("Load/Textures/%s/   Load/GraphicMods/", game_id.c_str());
+  ImGui::TextDisabled("Game/files/  <- all 1806 raw assets, editable directly");
+  ImGui::TextDisabled("Full instructions in MODDING.txt");
+}
